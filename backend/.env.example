# ─────────────────────────────────────────────────────────────
# The Yard — Configuration backend
# Copier ce fichier en « .env » puis adapter les valeurs.
# ─────────────────────────────────────────────────────────────

# ── Base de données ──
# Dev (aucune installation requise) :
DATABASE_URL=sqlite:///./theyard.db
# Prod (PostgreSQL 16) :
# DATABASE_URL=postgresql+psycopg://user:motdepasse@localhost:5432/theyard

# ── Sécurité ──
# OBLIGATOIRE en production. Générer avec :  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-a-remplacer-absolument-en-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── Compte administrateur initial (créé par « python -m app.seed ») ──
FIRST_ADMIN_EMAIL=admin@theyard-douala.com
FIRST_ADMIN_PASSWORD=TheYard2026!
FIRST_ADMIN_NAME=Administrateur

# ── CORS : origines autorisées du front (séparées par des virgules) ──
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── WhatsApp ──
# Numéro du restaurant qui reçoit les commandes (format international sans +)
WHATSAPP_STAFF_NUMBER=237671490733
# Cloud API Meta — laisser vide pour utiliser le mode fallback (lien wa.me).
# Dès que ces deux valeurs sont renseignées, les messages partent automatiquement.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ── Restaurant ──
RESTAURANT_NAME=The Yard
CURRENCY=FCFA
